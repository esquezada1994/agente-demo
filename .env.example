# Copiar a .env (make up y make setup lo hacen si no existe). .env NO se sube a git.
APP_ENV=local
SECRET_KEY=desarrollo-no-usar-en-produccion-0123456789abcdef

# --- Modelo -------------------------------------------------------------------
# Vacío = modelo simulado (solo local). Con OPENAI_API_KEY se usa OpenAI.
OPENAI_API_KEY=
# Para Azure OpenAI: las tres variables y MODEL_PROVIDER=azure_openai.
# Los modelos de la definición deben llamarse como tus deployments.
MODEL_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# --- Portal de gobernanza -------------------------------------------------------
# Visto desde el contenedor del agente.
PLATAFORMA_URL=http://host.docker.internal:8000
# Token de enrolamiento (ge_…): lo imprime `make seed` del portal, o en el portal:
# ficha de la solución → Integración → Generar token. Un solo uso, vence en 24 h.
ENROLL_TOKEN=

# --- Datos de la empresa para `make init` ----------------------------------------
EMPRESA=Distribuidora Demo
ADMIN_EMAIL=admin@distribuidora.demo
